{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": ["CLUSTER", "NEXT_PUBLIC_*"],
  "globalPassThroughEnv": [
    "RPC_URL",
    "WS_URL",
    "WEB_URL",
    "DATABASE_URL",
    "ADMIN_KEYPAIR_PATH",
    "KEEPER_KEYPAIR_PATH",
    "AGENT_KEYPAIR_PATH",
    "PRICE_MODE",
    "JUPITER_API_KEY",
    "FINNHUB_API_KEY",
    "PYTH_API_KEY",
    "MAINNET_READ_RPC_URL",
    "DEVNET_RPC_URL",
    "PRICE_INTERVAL",
    "SNAPSHOT_INTERVAL",
    "KEEPER_INTERVAL",
    "FEES_INTERVAL",
    "FOLLOW_INTERVAL",
    "GAMIFICATION_INTERVAL",
    "MCP_HTTP_PORT",
    "MCP_MAX_USDC_PER_ACTION",
    "MCP_WEB_URL",
    "MCP_AGENT_TOKEN",
    "AGENT_KEYPAIR_JSON",
    "AGENT_KEY_SECRET",
    "MCP_PUBLIC",
    "MCP_HOST",
    "MCP_ALLOWED_HOSTS",
    "MCP_RATE_LIMIT",
    "PORT",
    "FAUCET_SOL_PER_REQUEST",
    "FAUCET_SOL_DAILY_CAP",
    "SOLANA_CLI_CONFIG",
    "TEST_RPC_URL",
    "TEST_WS_URL",
    "TEST_DATABASE_URL",
    "ADMIN_KEYPAIR_JSON",
    "DATABASE_POOL_MAX",
    "DEVNET_DATABASE_URL",
    "DEVNET_WEB_URL",
    "VERCEL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "NEXT_OUTPUT_STANDALONE",
    "PATH",
    "HOME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
