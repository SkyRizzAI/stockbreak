// Cloudflare Worker for the web app (OpenNext), deployed by Workers Builds on push to main
// (docs/DEPLOY.md "Opsi C", D050). No secrets here: RPC_URL, WS_URL, AGENT_KEY_SECRET, ...
// are Worker secrets in the dashboard; the database is the D1 binding `DB`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stockbreak",
  "account_id": "89586fb20d63c1c6814d7ee5aa82a3d0",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Lets /api/mcp call this Worker's own API (a Worker can't fetch its own public URL).
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "stockbreak" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stockbreak",
      "database_id": "18fd9424-b32b-416c-b62d-9c84fc734387",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "routes": [{ "pattern": "stockbreak.fun", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "CLUSTER": "devnet",
    "NEXT_PUBLIC_CLUSTER": "devnet",
    "NEXT_PUBLIC_RPC_URL": "https://api.devnet.solana.com",
    "NEXT_PUBLIC_WS_URL": "wss://api.devnet.solana.com",
    "NEXT_PUBLIC_APP_NAME": "Stockbreak",
    "NEXT_PUBLIC_MCP_URL": "https://stockbreak.fun/api/mcp",
    "WEB_URL": "https://stockbreak.fun",
    "MCP_WEB_URL": "https://stockbreak.fun",
    // Required by the env schema; on Workers @repo/db uses the D1 binding `DB` (D051).
    "DATABASE_URL": "d1:DB",
    "FAUCET_SOL_PER_REQUEST": "0.1",
    "FAUCET_SOL_DAILY_CAP": "1"
  }
}
