# One root .env for every app (docs/PLAN.md §12). `bun run setup` creates .env from this file.

# cluster
CLUSTER=localnet                 # localnet | devnet
RPC_URL=http://127.0.0.1:8899
WS_URL=ws://127.0.0.1:8900
NEXT_PUBLIC_CLUSTER=localnet
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8900
NEXT_PUBLIC_APP_NAME=Stockbreak
WEB_URL=http://localhost:3000

# db
DATABASE_URL=postgres://postgres:postgres@localhost:5434/app

# keys (local keypair paths, never commit)
ADMIN_KEYPAIR_PATH=.keys/admin.json
KEEPER_KEYPAIR_PATH=.keys/keeper.json
AGENT_KEYPAIR_PATH=.keys/agent.json   # empty = MCP human-in-the-loop only

# prices
PRICE_MODE=live                  # live (PreStocks/Jupiter/Finnhub, read-only) | random
JUPITER_API_KEY=
FINNHUB_API_KEY=                 # optional, US stock fallback
PYTH_API_KEY=                    # optional
MAINNET_READ_RPC_URL=https://api.mainnet-beta.solana.com   # price reads only
DEVNET_RPC_URL=https://api.devnet.solana.com

# public devnet demo (docs/DEPLOY.md) — all optional
DEVNET_DATABASE_URL=             # hosted Postgres (Neon direct URL) for worker:devnet / start:devnet; empty = local docker app_devnet
VERCEL_DATABASE_URL=             # Neon pooled (-pooler) URL written to .env.vercel by `bun run vercel:env`
DEVNET_WEB_URL=                  # public web URL (Vercel domain or tunnel) used for Blinks/OG/MCP sign links
# DEVNET_PRICE_INTERVAL=30        # price feeder interval on devnet (seconds; RPC rate limits)
# ADMIN_KEYPAIR_JSON=             # hosted only (Vercel): content of .keys/admin.json for the SOL faucet; devnet upgrade authority, remove after judging
# DATABASE_POOL_MAX=              # Postgres pool size override (default 10, Vercel 3)
# DATABASE_PREPARE=false          # disable prepared statements (transaction-mode poolers other than *pooler* hosts / port 6543)

# worker intervals (seconds)
PRICE_INTERVAL=15                # devnet: 60
SNAPSHOT_INTERVAL=60
KEEPER_INTERVAL=30
FEES_INTERVAL=300
FOLLOW_INTERVAL=30
GAMIFICATION_INTERVAL=60

# mcp
MCP_HTTP_PORT=3333               # standalone server port (falls back to PORT on hosting platforms)
MCP_MAX_USDC_PER_ACTION=1000

# autonomous agent runner (bun run agent:loop, D044)
AGENT_MCP_URL=http://127.0.0.1:3333/mcp   # MCP server to drive (local or remote /mcp URL)
AGENT_MCP_TOKEN=                          # bearer token when the remote MCP gates agent_* tools
AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible chat completions API
AGENT_LLM_API_KEY=                        # empty = OPENROUTER_API_KEY (also read from .env.test)
AGENT_LLM_MODEL=                          # empty = OPENROUTER_MODEL, else anthropic/claude-sonnet-5
AGENT_LOOP_INTERVAL=900                   # seconds between cycles (min 30)
# Remote MCP (docs/DEPLOY.md "Remote MCP") — all optional
# NEXT_PUBLIC_MCP_URL=            # public MCP URL shown on the Agents page; empty = <web origin>/api/mcp
# MCP_WEB_URL=                    # base URL the MCP tools use to call the web API; empty = WEB_URL
# MCP_AGENT_TOKEN=                # secret (>=16 chars): Bearer token that unlocks agent_* on public endpoints (operator agent)
AGENT_KEY_SECRET=                 # secret (>=32 chars): encrypts web-created agent wallets + enables per-user API keys (D045); `bun run setup` generates it; keep it stable (same value on every server sharing the DB)
# AGENT_KEYPAIR_JSON=             # hosted only: content of .keys/agent.json (wins over AGENT_KEYPAIR_PATH)
# MCP_PUBLIC=1                    # standalone apps/mcp public mode (CORS, rate limit, token-gated agent_*)
# MCP_HOST=0.0.0.0                # standalone bind address in public mode (default 127.0.0.1)
# MCP_ALLOWED_HOSTS=mcp.example.com   # public mode Host allow-list (comma list); empty = any
# MCP_RATE_LIMIT=60               # public endpoints: requests per minute per client IP

# SOL faucet (devnet: transfer from admin)
FAUCET_SOL_PER_REQUEST=0.2
FAUCET_SOL_DAILY_CAP=5

# project-local solana cli config (never use the global one)
SOLANA_CLI_CONFIG=.keys/solana-cli.yml

# tests (isolated from dev)
TEST_RPC_URL=http://127.0.0.1:18899
TEST_WS_URL=ws://127.0.0.1:18900
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/app_test
