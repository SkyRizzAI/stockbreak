# One root .env for every app (docs/PLAN.md §12). `bun run setup` creates .env from this file.

# cluster
CLUSTER=localnet                 # localnet | devnet
RPC_URL=http://127.0.0.1:8899
WS_URL=ws://127.0.0.1:8900
NEXT_PUBLIC_CLUSTER=localnet
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8900
NEXT_PUBLIC_APP_NAME=Stocklana
WEB_URL=http://localhost:3000

# db
DATABASE_URL=postgres://postgres:postgres@localhost:5434/app

# keys (local keypair paths, never commit)
ADMIN_KEYPAIR_PATH=.keys/admin.json
KEEPER_KEYPAIR_PATH=.keys/keeper.json
AGENT_KEYPAIR_PATH=.keys/agent.json   # empty = MCP human-in-the-loop only

# prices
PRICE_MODE=random                # live | random
JUPITER_API_KEY=
FINNHUB_API_KEY=                 # optional, US stock fallback
PYTH_API_KEY=                    # optional
MAINNET_READ_RPC_URL=https://api.mainnet-beta.solana.com   # price reads only
DEVNET_RPC_URL=https://api.devnet.solana.com

# worker intervals (seconds)
PRICE_INTERVAL=15                # devnet: 60
SNAPSHOT_INTERVAL=60
KEEPER_INTERVAL=30
FEES_INTERVAL=300
FOLLOW_INTERVAL=30
GAMIFICATION_INTERVAL=60

# mcp
MCP_HTTP_PORT=3333
MCP_MAX_USDC_PER_ACTION=1000

# SOL faucet (devnet: transfer from admin)
FAUCET_SOL_PER_REQUEST=0.2
FAUCET_SOL_DAILY_CAP=5

# project-local solana cli config (never use the global one)
SOLANA_CLI_CONFIG=.keys/solana-cli.yml

# tests (isolated from dev)
TEST_RPC_URL=http://127.0.0.1:18899
TEST_WS_URL=ws://127.0.0.1:18900
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/app_test
